{
  "name": "stak",
  "private": true,
  "version": "0.0.0",
  "description": "PesaSense: a private on-device financial profile and a small Bitcoin habit.",
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "corepack pnpm --filter @pesasense/web dev",
    "build": "corepack pnpm --filter @pesasense/web build",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
