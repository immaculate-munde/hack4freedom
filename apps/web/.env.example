# Copy this file to apps/web/.env.local and fill in the keys.
# .env.local is gitignored. Do not commit real keys.

# Bitika sandbox key for local dev (bk_test_…). See docs/bitika-api.md.
# Live keys (bk_live_…) are blocked unless BITIKA_ALLOW_LIVE=true.
BITIKA_API_KEY=

# Required on production when BITIKA_API_KEY starts with bk_live_.
# BITIKA_ALLOW_LIVE=true

# Breez SDK Spark — in-app Lightning wallet.
# Request a key at https://breez.technology/request-api-key/
NEXT_PUBLIC_BREEZ_API_KEY=

# Turn off Amina/Brian demo personas. Profile comes from SMS import on this phone.
# Set BOTH (server + browser) and restart `pnpm dev` after changing.
PROFILE_SOURCE=parsed
NEXT_PUBLIC_PROFILE_SOURCE=parsed

# Buffer-first gate blocks Invest when the import looks thin. Set false to demo
# with your own strong M-Pesa statement when PDF parsing under-counts income.
# NEXT_PUBLIC_BUFFER_GATE=false

# Signing secret from Bitika when you register a webhook URL.
# The app does not log into Bitika to create this. Register
# https://<your-host>/api/onramp/webhook in the Bitika dashboard.
# BITIKA_WEBHOOK_SECRET=

# Relays for the encrypted profile. Comma-separated. Defaults to wss://relay.damus.io.
# NEXT_PUBLIC_NOSTR_RELAYS=wss://relay.damus.io

# USSD callback. Africa's Talking posts form fields to /api/ussd.
# Live dashboard value:
#   https://pesasense.vercel.app/api/ussd?key=YOUR_USSD_API_KEY
# The query value is USSD_API_KEY below, not BITIKA_API_KEY.
# Leave the key empty in local development. Production refuses every
# request until USSD_API_KEY is set. See docs/ussd.md.
# USSD_PROVIDER=africastalking
# USSD_SERVICE_CODE=*384*40401#
# USSD_API_KEY=
# USSD_SESSION_TTL_SECONDS=180
# USSD_MAX_REQUESTS_PER_MINUTE=20
# USSD_MAX_BUYS_PER_HOUR=3
# Shared SQLite file for phone links and the purchase index.
# Unset in production uses in-memory storage for this process.
# USSD_STORE_PATH=

# Telegram bot (optional). Statements sent to the bot leave the phone —
# see docs/telegram.md. Do not commit a real token.
# TELEGRAM_BOT_TOKEN=
# Optional secret for setWebhook secret_token (header X-Telegram-Bot-Api-Secret-Token).
# TELEGRAM_WEBHOOK_SECRET=
# Public username without @ — enables the "Open in Telegram" link on /welcome.
# NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# TELEGRAM_BOT_USERNAME=
# Session JSON path (dev default: apps/web/.data/telegram-sessions.json).
# TELEGRAM_STORE_PATH=
# TELEGRAM_SESSION_TTL_SECONDS=86400

# Sensi voice (optional). Thin /sensi path: profile facts → LLM → ElevenLabs.
# Do not commit real keys. Without keys the API returns a clear "key missing".
# Prefer OpenRouter (sk-or-…):
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openai/gpt-4o-mini
# Legacy DashScope / Qwen still work if OPENROUTER_API_KEY is unset:
# QWEN_API_KEY=
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-plus
# ELEVENLABS_API_KEY=
# Warm conversational default = Charlotte. Override for African / custom clones:
# ELEVENLABS_VOICE_ID=XB0fDUnXU5powFXDhCwa
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Softer, kinder delivery (defaults shown):
# ELEVENLABS_STABILITY=0.38
# ELEVENLABS_SIMILARITY_BOOST=0.78
# ELEVENLABS_STYLE=0.32
# ELEVENLABS_SPEED=0.94
