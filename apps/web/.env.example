# Copy this file to apps/web/.env.local and fill in the keys.
# .env.local is gitignored. Do not commit real keys.

# Bitika sandbox key for local dev (bk_test_…). See docs/bitika-api.md.
# Live keys (bk_live_…) are blocked unless BITIKA_ALLOW_LIVE=true.
BITIKA_API_KEY=

# Required on production when BITIKA_API_KEY starts with bk_live_.
# BITIKA_ALLOW_LIVE=true

# Breez SDK Spark — in-app Lightning wallet.
# Request a key at https://breez.technology/request-api-key/
NEXT_PUBLIC_BREEZ_API_KEY=

# Profile source for the home screen. Omit this (or set demo) to show
# the invented Amina / Brian profiles. Set parsed to turn demo data off.
# PROFILE_SOURCE=demo

# Signing secret from Bitika when you register a webhook URL.
# The app does not log into Bitika to create this. Register
# https://<your-host>/api/onramp/webhook in the Bitika dashboard.
# BITIKA_WEBHOOK_SECRET=

# Relays for the encrypted profile. Comma-separated. Defaults to wss://relay.damus.io.
# NEXT_PUBLIC_NOSTR_RELAYS=wss://relay.damus.io
